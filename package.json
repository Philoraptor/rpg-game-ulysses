{
  "name": "rpg-game-ulysses",
  "version": "0.1.0",
  "description": "2D Top-Down RPG - Project ULYSSES (Unified Layer System for Screen-Editable Scenarios)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=game-client",
    "dev:server": "npm run dev --workspace=game-server",
    "dev:editor": "npm run dev --workspace=map-editor",
    "dev:all": "npm-run-all --parallel dev:client dev:server",
    "build": "vite build",
    "build:client": "npm run build --workspace=game-client",
    "build:server": "npm run build --workspace=game-server",
    "build:editor": "npm run build --workspace=map-editor",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json}\"",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "convert:assets": "npm run convert --workspace=asset-pipeline",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/rpg-game-ulysses.git"
  },
  "keywords": [
    "rpg",
    "game",
    "2d",
    "canvas",
    "phaser",
    "mmorpg",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "phaser": "^3.80.1",
    "vite": "^5.4.0",
    "zod": "^4.1.12"
  }
}
